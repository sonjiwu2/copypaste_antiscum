# Copy to .env for local overrides (optional — defaults work out of the box):
#   cp .env.example .env
#
# Never commit real secrets. .env is gitignored.

# Host port mapped to backend container port 8080
BACKEND_PORT=8080

# Backend log level: debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL (Backend №2) ---
# Local demo credentials only. Production secrets are supplied by the platform,
# never by this file.
POSTGRES_DB=antiscam
POSTGRES_USER=antiscam
POSTGRES_PASSWORD=change-me-locally

# Read by the api and migrate binaries. Host `postgres` is the Compose service.
DATABASE_URL=postgres://antiscam:change-me-locally@postgres:5432/antiscam?sslmode=disable

# --- Anonymous profile cookie ---
# COOKIE_NAME=ast_profile
# COOKIE_MAX_AGE=4320h
# Secure must be true in any public deployment (requires HTTPS).
# COOKIE_SECURE=false
# lax (default) | strict | none. `none` is only for a frontend on a different
# site and requires COOKIE_SECURE=true — the browser drops it otherwise.
# COOKIE_SAME_SITE=lax

# --- Browser access from another origin ---
# Empty by default: Compose serves the frontend and the API from one origin,
# so no cross-origin access is granted. List full origins, comma separated;
# `*` is rejected because responses are tied to the profile cookie.
# CORS_ALLOWED_ORIGINS=https://trainer.example,https://www.trainer.example

# Attempt storage: postgres (default) | memory.
# `memory` loses every attempt on restart and exists only for tests and for a
# database-free demo. It is never selected automatically.
# STORAGE_DRIVER=postgres

# Connection pool and timeouts (optional — defaults work out of the box).
# DATABASE_MAX_CONNS=10
# DATABASE_MIN_CONNS=0
# DATABASE_CONNECT_TIMEOUT=5s
# DATABASE_QUERY_TIMEOUT=5s
# DATABASE_HEALTH_TIMEOUT=2s

# --- Groq Cloud weekly tests (preferred free provider) ---
# Create a key at https://console.groq.com/keys. It is read only by the
# backend and must never be copied into frontend code or a VITE_* variable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT=40s

# --- Optional paid xAI/Grok fallback provider ---
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
XAI_REQUEST_TIMEOUT=40s

# Separate database for PostgreSQL integration tests. The test suite RECREATES
# the public schema in it — never point this at a database with real data.
# TEST_DATABASE_URL=postgres://antiscam:change-me-locally@127.0.0.1:5432/antiscam_test?sslmode=disable

# --- Frontend ---
# Host port mapped to the nginx container port 8080.
FRONTEND_PORT=3000
