{
  "name": "anti-scam-trainer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "test": "vitest run",
    "process-assets": "tsx scripts/process_ui_assets.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "prettier . --check",
    "check:fix": "prettier . --write --ignore-unknown"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
